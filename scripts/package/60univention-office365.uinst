#!/bin/sh
#
#
# MS Office 365 provisioning
#  unjoin script
#
# SPDX-FileCopyrightText: 2016-2025 Univention GmbH
# SPDX-License-Identifier: AGPL-3.0-only

## joinscript api: bindpwdfile

VERSION=2

. /usr/share/univention-join/joinscripthelper.lib
. /usr/share/univention-lib/all.sh

joinscript_init

ucs_removeServiceFromLocalhost "univention-office365" "$@" || die

if ucs_isServiceUnused "univention-office365" "$@"
then
	eval "$(ucr shell ldap/base)"
	ea_base="cn=custom attributes,cn=univention,$ldap_base"
	udm settings/extended_attribute remove "$@" \
		--dn "cn=UniventionOffice365Enabled,$ea_base"
	udm settings/extended_attribute remove "$@" \
		--dn "cn=UniventionOffice365ObjectID,$ea_base"
	udm settings/extended_attribute remove "$@" \
		--dn "cn=UniventionOffice365Data,$ea_base"
	udm settings/extended_attribute remove "$@" \
		--dn "cn=UniventionOffice365GroupObjectID,$ea_base"
	udm settings/extended_attribute remove "$@" \
		--dn "cn=UniventionOffice365userPrincipalName,$ea_base"
	udm settings/extended_attribute remove "$@" \
		--dn "cn=UniventionOffice365GroupData,$ea_base"
	udm settings/extended_attribute remove "$@" \
		--dn "cn=UniventionOffice365GroupProfile,$ea_base"
	udm settings/extended_attribute remove "$@" \
		--dn "cn=UniventionOffice365TokenResetDate,$ea_base"
	udm settings/extended_attribute remove "$@" \
		--dn "cn=UniventionOffice365ADConnectionAlias,$ea_base"
	udm settings/extended_attribute remove "$@" \
		--dn "cn=UniventionOffice365GroupADConnectionAlias,$ea_base"
	udm settings/extended_attribute remove "$@" \
		--dn "cn=UniventionMicrosoft365Team,$ea_base"
	udm settings/extended_attribute remove "$@" \
		--dn "cn=UniventionMicrosoft365GroupOwners,$ea_base"
	udm settings/extended_attribute remove "$@" \
		--dn "cn=UniventionMicrosoft365GroupType,$ea_base"
	udm settings/extended_attribute remove "$@" \
		--dn "cn=UniventionMicrosoft365ForceGroupType,$ea_base"
	udm settings/extended_attribute remove "$@" \
		--dn "cn=UniventionMicrosoft365GroupVisibility,$ea_base"
	udm settings/extended_attribute remove "$@" \
		--dn "cn=UniventionMicrosoft365EducationClassCode,$ea_base"
	udm settings/extended_attribute remove "$@" \
		--dn "cn=UniventionMicrosoft365EducationClassGrade,$ea_base"
	udm settings/extended_attribute remove "$@" \
		--dn "cn=UniventionMicrosoft365EducationTermDisplayName,$ea_base"
	udm settings/extended_attribute remove "$@" \
		--dn "cn=UniventionMicrosoft365EducationTermExternalId,$ea_base"
	udm settings/extended_attribute remove "$@" \
		--dn "cn=UniventionMicrosoft365EducationTermStartDate,$ea_base"
	udm settings/extended_attribute remove "$@" \
		--dn "cn=UniventionMicrosoft365EducationTermEndDate,$ea_base"

	udm settings/usertemplate remove "$@" \
		--dn "cn=Office 365 Account,cn=templates,cn=univention,$ldap_base"
fi

ucr unset ucs/web/overview/entries/service/office365/description \
	ucs/web/overview/entries/service/office365/label \
	ucs/web/overview/entries/service/office365/link \
	ucs/web/overview/entries/service/office365/description/de \
	ucs/web/overview/entries/service/office365/label/de \
	ucs/web/overview/entries/service/office365/priority \
	ucs/web/overview/entries/service/office365/icon

stop_udm_cli_server

joinscript_remove_script_from_status_file univention-office365

exit 0
