"""
Univention Microsoft 365 disable expired users
"""

import sys
import logging
import zlib

from argparse import ArgumentParser
from datetime import datetime
from logging.handlers import SysLogHandler

from univention.udm import UDM

from univention.office365.microsoft.account import AzureAccount
from univention.office365.microsoft.objects.azureobjects import UserAzure
from univention.office365.microsoft.core import MSGraphApiCore
from univention.office365.udmwrapper.udmobjects import UniventionOffice365Data
from univention.office365.logging2udebug import get_logger
from univention.office365.microsoft.exceptions.core_exceptions import MSGraphError

# Query local LDAP for users that are activated for O365
# invalidate all auth tokens for one or --max-modifications users


def get_customized_logger(options):
    logger = get_logger('office365', 'o365')
    if options.verbose:
        _handler = logging.StreamHandler(sys.stdout)
    else:
        _handler = SysLogHandler(address='/dev/log', facility=SysLogHandler.LOG_SYSLOG)
    _handler.setLevel(logging.INFO)
    logger.addHandler(_handler)

    return logger


def parse_arguments(args):
    parser = ArgumentParser(description='A tool to disable users in Azure AD when they reached their expiry date.')
    parser.add_argument('-m', '--modify', action='store_true', help='Modify users, default: dry-run')
    parser.add_argument('-o', '--onlyone', metavar='uid', help='Only look at and modify one user (for testing purposes)')
    parser.add_argument('-v', '--verbose', action='store_true', help='Log information on stdout')
    options = parser.parse_args()
    return options


def main(options):
    logger.info('M365_Expire: Disabling expired Microsoft 365 users')
    try:
        udm = UDM.machine().version(2)
        usermod = udm.get('users/user')
    except Exception as exc:
        logger.exception(f'M365_Expire: Failed to initilize Microsoft 365 token reset script: {exc}')
        raise

    today = datetime.utcnow().strftime('%Y%m%d%H%M%SZ')
    if options.onlyone:
        ldap_filter = f'(&(univentionObjectType=users/user)(uid={options.onlyone}))'
    else:
        ldap_filter = f'(&(univentionOffice365Enabled=1)(univentionObjectType=users/user)(krb5ValidEnd=*)(krb5ValidEnd<={today}))'
    for user in usermod.search(filter_s=ldap_filter):
        try:
            adconnection_objects = UniventionOffice365Data.from_ldap(user.props.UniventionOffice365Data)
        except (zlib.error, TypeError):
            logger.error('M365_Expire: Error decoding o365data for user {uid}')
            adconnection_objects = {}
        except KeyError:
            logger.error(f'M365_Expire: Error: user {user.props.username} is not correctly synced to Azure (missing univentionOffice365Data attribute)')

        for alias, values in adconnection_objects.items():
            core = MSGraphApiCore(AzureAccount(alias))
            try:
                azure_user = UserAzure.get(core, object_id=values['objectId'])
                azure_user_enabled = UserAzure.get(core, object_id=values['objectId'], selection=['accountEnabled']).accountEnabled
            except MSGraphError as exc:
                logger.error(f'M365_Expire: Could not get user: {user.props.username} in connection: {alias} from Azure: {exc}')
                continue

            if azure_user_enabled:
                if not options.modify:
                    logger.info(f'M365_Expire: Would modify user: {user.props.username} in connection: {alias}')
                    continue
                try:
                    azure_user.deactivate(rename=False)
                except MSGraphError as exc:
                    logger.error(f'M365_Expire: Could not deactivate user: {user.props.username} in connection: {alias} from Azure: {exc}')
                    continue
                logger.info(f'M365_Expire: Modified user: {user.props.username} in connection {alias}')


if __name__ == '__main__':
    options = parse_arguments(sys.argv[1:])
    logger = get_customized_logger(options)
    main(options)
