#!/usr/bin/make -f
#
# Univention Office 365
#  rules file for the debian package
#
# SPDX-FileCopyrightText: 2016-2025 Univention GmbH
# SPDX-License-Identifier: AGPL-3.0-only

export PYBUILD_NAME=univention-office365

override_dh_auto_build:
	dh-umc-module-build
	univention-l10n-build de
	dh_auto_build

override_dh_auto_install:
	univention-install-config-registry
	dh-umc-module-install
	univention-l10n-install de
	dh_auto_install

override_dh_auto_test:
	$(shell touch modules/conftest.py) # needed by test to import local source
	PYTHONPATH=./modules pytest-3 test/

override_dh_systemd_enable:
	dh_systemd_enable --name=univention-ms-office-async

%:
	dh $@ --with systemd --with python3 --buildsystem=pybuild
